# Local PostgreSQL connection. Replace the password with the one assigned to the nexus role.
DATABASE_URL=postgresql://nexus:replace-with-a-local-password@127.0.0.1:5433/academic_nexus
API_PORT=3001
DEMO_PASSWORD=replace-with-a-long-random-shared-demo-password
SESSION_SECRET=replace-with-at-least-32-random-characters
